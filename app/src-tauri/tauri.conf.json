{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grabbit",
  "version": "2.0.21",
  "identifier": "app.grabbit",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["grabbit"] } },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgxRDMzNDQ5OTExMkM1NTMKUldSVHhSS1JTVFRUZ1dKRWxzSDRmNm4zNnFQVmxyZjJZUUE4M3hIWGxsNVBmVTkzcEoyTHhyRFoK",
      "endpoints": ["https://github.com/JakeTheRabbit/Grabbit---Screenshot-tool-for-vibe-coders/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi", "dmg", "app", "appimage", "deb", "rpm"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Utility",
    "publisher": "JakeTheRabbit",
    "copyright": "Copyright (c) 2026 JakeTheRabbit. MIT licence.",
    "homepage": "https://jaketherabbit.github.io/Grabbit---Screenshot-tool-for-vibe-coders/",
    "shortDescription": "Screenshots and screen recordings, straight to the clipboard",
    "macOS": { "minimumSystemVersion": "13.0", "entitlements": null, "infoPlist": "Info.plist", "signingIdentity": "-" },
    "linux": { "deb": { "depends": ["ffmpeg"], "recommends": ["tesseract-ocr"] } }
  }
}
