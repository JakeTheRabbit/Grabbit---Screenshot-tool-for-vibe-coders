{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grabbit",
  "version": "2.0.2",
  "identifier": "app.grabbit",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["grabbit"] } }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "appimage", "deb", "rpm"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Screenshots and screen recordings, straight to the clipboard",
    "macOS": { "minimumSystemVersion": "13.0", "entitlements": null, "infoPlist": "Info.plist" },
    "linux": { "deb": { "depends": ["ffmpeg"], "recommends": ["tesseract-ocr"] } }
  }
}
